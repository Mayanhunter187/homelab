apiVersion: v1
kind: Namespace
metadata:
  name: monitoring
{% if monitoring_grafana_password %}
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: monitoring
type: Opaque
stringData:
  admin-user: admin
  admin-password: {{ monitoring_grafana_password | to_json }}
{% endif %}
{% if monitoring_discord_webhook %}
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-discord
  namespace: monitoring
type: Opaque
stringData:
  url: {{ monitoring_discord_webhook | to_json }}
{% endif %}
