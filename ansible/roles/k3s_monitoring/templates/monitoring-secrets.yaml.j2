apiVersion: v1
kind: Namespace
metadata:
  name: monitoring
{% if monitoring_grafana_password %}
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: monitoring
type: Opaque
# data, not stringData: kubectl apply reports stringData as changed on every run
data:
  admin-user: "{{ 'admin' | b64encode }}"
  admin-password: "{{ monitoring_grafana_password | b64encode }}"
{% endif %}
{% if monitoring_discord_webhook %}
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-discord
  namespace: monitoring
type: Opaque
data:
  url: "{{ monitoring_discord_webhook | b64encode }}"
{% endif %}
