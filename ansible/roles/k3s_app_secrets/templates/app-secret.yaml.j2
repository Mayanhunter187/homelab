apiVersion: v1
kind: Namespace
metadata:
  name: {{ item.namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ item.name }}
  namespace: {{ item.namespace }}
type: Opaque
# data, not stringData: kubectl apply reports stringData as changed on every run
data:
{% for key, parameter in item.data.items() %}
  {{ key }}: "{{ lookup('amazon.aws.ssm_parameter', parameter) | b64encode }}"
{% endfor %}
